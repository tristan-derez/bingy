{
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "ESNext",

		"declaration": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"noEmit": false,

		"strict": true,
		"skipLibCheck": true,

		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "**/*.test.ts", "dist"]
}
