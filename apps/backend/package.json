{
	"name": "backend",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run --hot --no-clear-screen src/index.ts",
		"db:studio": "drizzle-kit studio --config=./drizzle.config.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:drop": "drizzle-kit drop",
		"build": "bun build src/index.ts --outdir ./dist --target bun",
		"email:dev": "email dev --dir ./src/emails"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.7.2",
		"@react-email/components": "0.5.3",
		"better-auth": "^1.3.26",
		"drizzle-orm": "^0.44.4",
		"hono": "^4.9.1",
		"http-status-codes": "^2.3.0",
		"pino": "^9.9.0",
		"postgres": "^3.4.7",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"resend": "^6.1.0",
		"zod": "^4.0.17"
	},
	"devDependencies": {
		"@react-email/preview-server": "4.2.11",
		"@types/bun": "latest",
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"drizzle-kit": "^0.31.4",
		"react-email": "4.2.11"
	},
	"imports": {
		"#web/": "./src/web/*",
		"#schemas/": "./src/db/schemas/*",
		"#utils/": "./src/utils/*",
		"#emails/": "./src/emails/*",
		"#types/": ".src/types/*"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
