{
	"name": "backend",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run --hot --no-clear-screen src/index.ts",
		"db:studio": "drizzle-kit studio --config=./drizzle.config.ts",
		"db": "drizzle-kit",
		"build": "bun build src/index.ts --outdir ./dist --target bun",
		"email:dev": "email dev --dir ./src/emails"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1136.0",
		"@hono/zod-validator": "^0.7.6",
		"@react-email/components": "0.5.3",
		"better-auth": "^1.7.5",
		"drizzle-orm": "^0.44.7",
		"file-type": "^22.1.1",
		"hono": "^4.13.8",
		"http-status-codes": "^2.3.0",
		"nanoid": "^5.1.16",
		"node-emoji": "^2.2.0",
		"ofetch": "^1.5.1",
		"pino": "^9.14.0",
		"pino-pretty": "^13.1.3",
		"postgres": "^3.4.9",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"resend": "^6.28.1",
		"shared": "workspace:*",
		"sharp": "^0.34.5",
		"slugify": "^1.6.9",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@react-email/preview-server": "4.2.11",
		"@types/bun": "latest",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"drizzle-kit": "^0.31.10",
		"react-email": "4.2.11"
	},
	"imports": {
		"#web/": "./src/web/*",
		"#db/schemas/": "./src/db/schemas/*",
		"#utils/": "./src/utils/*",
		"#emails/": "./src/emails/*",
		"#types/": ".src/types/*",
		"#validators/": "./src/web/validators/*"
	}
}
