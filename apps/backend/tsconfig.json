{
	"compilerOptions": {
		"strict": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"paths": {
			"#lib/*": ["./src/lib/*"],
			"#emails/*": ["./src/emails/*"],
			"#schemas/*": ["./src/db/schemas/*"],
			"#middlewares/*": ["./src/middlewares/*"],
			"#tasks/*": ["./src/tasks/*"],
			"#utils/*": ["./src/utils/*"],
			"#web/*": ["./src/web/*"]
		}
	}
}
